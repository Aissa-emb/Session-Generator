# Enter only the platforms to enable. At least one distinct five-character ID.
SG_WEB_APP_ID=
SG_ANDROID_APP_ID=
SG_IOS_APP_ID=
SG_WEB_APP_NAME=Vantra Web
SG_ANDROID_APP_NAME=Vantra
SG_IOS_APP_NAME=Vantra
SG_WEB_INGEST_REGION=us
SG_ANDROID_INGEST_REGION=us
SG_IOS_INGEST_REGION=us
# TOTAL requested rate across enabled platforms, not per platform.
SG_RATE_PER_MINUTE=10
# Operational label; this does not change the source IP or session geography.
SG_RUNNER_REGION=kubernetes
