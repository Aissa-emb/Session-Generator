<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.xcor-demo-generator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-u</string>
    <string>/Users/aissamamdouh/xcor-demo-generator/generate.py</string>
    <string>--profile</string>
    <string>all</string>
    <string>--rate</string>
    <string>10</string>
    <string>--quiet</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/aissamamdouh/xcor-demo-generator</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/Users/aissamamdouh/xcor-demo-generator/logs/generator.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aissamamdouh/xcor-demo-generator/logs/generator.log</string>
</dict>
</plist>
